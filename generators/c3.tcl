proc highlight { tokens } {
    variable c3_keywords
    variable c3_types
    set tokens [ preprocess_tokens $tokens ]
    set types [ highlight_generic $c3_keywords $c3_types $tokens ]
    set types [ postprocess_types $types $tokens ]
    set result {}
    foreach t $types {
        lappend result [ standard_color $t ]
    }
    return $result
}

proc highlight_generic { keywords kw_types tokens } {
    set result {}
    set state "idle"
    set ntok [ llength $tokens ]
    set i 0
    while { 1 } {
        if {$i < $ntok} {
            
        } else {
            break
        }
        set token [ lindex $tokens $i ]
        set inext [ expr { $i + 1 } ]
        set lookahead [ lindex $tokens $inext ]
        lassign \
        $token \
        type text
        if {$state == "idle"} {
            set state [ idle_default $keywords $kw_types \
            	result $type $text $lookahead ]
        } else {
            if {$state == "string"} {
                lappend result "char"
                if {$text == "\""} {
                    set state "idle"
                } else {
                    if {$text == "\\"} {
                        set state "escaping"
                    } else {
                        if {$text == "\n"} {
                            set state "idle"
                        }
                    }
                }
            } else {
                if {$state == "escaping"} {
                    lappend result "char"
                    if {$text == "\n"} {
                        set state "idle"
                    } else {
                        set state "string"
                    }
                } else {
                    if {$state == "comment start"} {
                        if {$text == "*"} {
                            set state "comment"
                            lappend result "comment" "comment"
                        } else {
                            if {$text == "/"} {
                                set state "comment line"
                                lappend result "comment" "comment"
                            } else {
                                lappend result "op"
                                set state [ idle_default $keywords $kw_types \
                                	result $type $text $lookahead ]
                            }
                        }
                    } else {
                        if {$state == "comment"} {
                            lappend result "comment"
                            if {$text == "*"} {
                                set state "comment end"
                            }
                        } else {
                            if {$state == "comment end"} {
                                lappend result "comment"
                                if {$text == "/"} {
                                    set state "idle"
                                }
                            } else {
                                if {$state == "comment line"} {
                                    lappend result "comment"
                                    if {$text == "\n"} {
                                        set state "idle"
                                    }
                                } else {
                                    if {$state == "char"} {
                                        lappend result "char"
                                        if {$text == "'"} {
                                            set state "idle"
                                        } else {
                                            if {$text == "\\"} {
                                                set state "char escaping"
                                            } else {
                                                if {$text == "\n"} {
                                                    set state "idle"
                                                }
                                            }
                                        }
                                    } else {
                                        if {$state == "char escaping"} {
                                            lappend result "char"
                                            if {$text == "\n"} {
                                                set state "idle"
                                            } else {
                                                set state "char"
                                            }
                                        } else {
                                            if {$state == "verbatim start"} {
                                                if {$text == "\""} {
                                                    lappend result "char" "char"
                                                    set state "verbatim"
                                                } else {
                                                    lappend result "op"
                                                    set state [ idle_default $keywords $kw_types \
                                                    	result $type $text $lookahead ]
                                                }
                                            } else {
                                                if {$state == "verbatim"} {
                                                    lappend result "char"
                                                    if {$text == "\""} {
                                                        set state "verbatim end"
                                                    }
                                                } else {
                                                    if {$state == "verbatim end"} {
                                                        
                                                    } else {
                                                        error "Unexpected switch value: $state"
                                                    }
                                                    if {$text == "\""} {
                                                        lappend result "char"
                                                        set state "verbatim"
                                                    } else {
                                                        set state [ idle_default $keywords $kw_types \
                                                        	result $type $text $lookahead ]
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        incr i
    }
    if {($state == "comment start") || ($state == "verbatim start")} {
        lappend result "op"
    }
    return $result
}

proc idle_default { keywords kw_types result_name type text lookahead } {
    upvar 1 $result_name result
    set delims {
    	"(" ")" "[" "]" ";"
    	"<" ">" "\{" "\}" }
    set consts { true false }
    set op_access { "::" "->" "." }
    if {$text == "\""} {
        lappend result "char"
        set state "string"
    } else {
        if {$text == "'"} {
            lappend result "char"
            set state "char"
        } else {
            if {$text == "/"} {
                set state "comment start"
            } else {
                if {$text == "@"} {
                    set state "verbatim start"
                } else {
                    if {$type == "token"} {
                        if {[contains $kw_types $text]} {
                            set type "type"
                        } else {
                            if {[contains $keywords $text]} {
                                set type "keyword"
                            } else {
                                if {[contains $consts $text]} {
                                    set type "const"
                                } else {
                                    lassign \
                                    $lookahead \
                                    lahtype lahtext
                                    if {$lahtype == "op" &&
	[ contains $op_access $lahtext ]} {
                                        set type "access"
                                    } else {
                                        if {$lahtype == "op" &&
	$lahtext == ">"} {
                                            set type "type"
                                        } else {
                                            if {[ regexp {^[0-9A-Z_]+$} $text ]} {
                                                set type "macro"
                                            } else {
                                                set type "id"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        if {$type == "op" &&
	[ contains $delims $text ]} {
                            set type "delim"
                        }
                    }
                    lappend result $type
                    set state "idle"
                }
            }
        }
    }
    return $state
}

