proc make_callbacks { } {
    set callbacks {}
    gen::put_callback callbacks assign        gen_c3::assign
    gen::put_callback callbacks compare       gen_c3::compare
    gen::put_callback callbacks compare2      gen_c3::compare
    gen::put_callback callbacks bad_case      gen_c3::bad_case
    
    gen::put_callback callbacks body          gen_c3::generate_body
    gen::put_callback callbacks signature     gen_cpp::extract_signature
    gen::put_callback callbacks and           gen_c3::p.and
    gen::put_callback callbacks or            gen_c3::p.or
    gen::put_callback callbacks not           gen_c3::p.not
    gen::put_callback callbacks declare       gen_c3::declare
    
    gen::put_callback callbacks if_start      gen_c3::if_start
    gen::put_callback callbacks if_end        gen_c3::if_end
    gen::put_callback callbacks else_start    gen_c3::else_start
    gen::put_callback callbacks elseif_start  gen_c3::elseif_start
    gen::put_callback callbacks block_close   gen_c3::block_close
    gen::put_callback callbacks return_none   gen_c3::return_none
    gen::put_callback callbacks shelf         gen_c3::shelf
    gen::put_callback callbacks output        gen_c3::output_icon
    
    gen::put_callback callbacks while_start   gen_c3::while_start
    gen::put_callback callbacks pass          gen_c3::pass
    gen::put_callback callbacks comment       gen_c3::comment
    gen::put_callback callbacks break         "break;"
    return $callbacks
}

proc output_icon { primary secondary } {
    set result {}
    set lines [ split $primary "\n" ]
    set nline [ llength $lines ]
    if {$secondary == "debug"} {
        lappend result "#if !NDEBUG"
        set fp "stderr"
    } else {
        if {$secondary == ""} {
            set fp "stdout"
        } else {
            set fp $secondary
        }
    }
    if {$nline == 1} {
        set prli [ lindex $lines 0 ]
        lappend result "fputs($prli,$fp);"
    } else {
        set prli [ join $lines "," ]
        lappend result "fprintf($fp,$prli);"
    }
    if {$secondary == "debug"} {
        lappend result "#endif"
    }
    return [ join $result "\n" ]
}

proc p.and { left right } {
