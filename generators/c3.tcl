# Autogenerated with DRAKON Editor 1.33

proc assign { var value } {
    return "$var = $value;"
}

proc bad_case { switch_var select_icon_number } {
    if {[ string compare -nocase $switch_var "select" ] == 0} {
        return "assert(0 && \"Unexpected condition\");"
    } else {
        return "assert(0 && \"Unexpected $switch_var\");"
    }
}

proc block_close { output depth } {
    upvar 1 $output result
    set line [ gen::make_indent $depth ]
    append line "\}"
    lappend result $line
}

proc comment { text } {
    return "//" $text
}

proc compare { var value } {
    return "$var == $value"
}

proc declare { type name value } {
    if {$value == ""} {
        return "$type $name;"
    } else {
        return "$type $name = $value;"
    }
}

proc else_start { } {
    return "\} else \{"
}

proc elseif_start { } {
    return "\} else if \("
}

proc generate { db gdb filename } {
    p.generate $db $gdb $filename "c"
}

proc generate_body { gdb diagram_id start_item node_list items incoming } {
    set callbacks [ make_callbacks ]
    generate_body_goto \
    $gdb $diagram_id $start_item $node_list $items $incoming \
    $callbacks
}

