    #item 939
    set consts { true false }
    #item 991
    set op_access { "::" "->" "." }
    #item 7210001
    if {$text == "\""} {
        #item 732
        lappend result "char"
        #item 738
        set state "string"
    } else {
        #item 7210002
        if {$text == "'"} {
            #item 733
            lappend result "char"
            #item 734
            set state "char"
        } else {
            #item 7210003
            if {$text == "/"} {
                #item 735
