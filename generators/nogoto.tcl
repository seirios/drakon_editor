proc generate_item { db item_id parent_loop } {
    set type [ get_node_type $db $item_id ]
    if {$type == "action"} {
        set fun gen_action
    } else {
        if {$type == "if"} {
            set fun gen_if
        } else {
            if {$type == "loop"} {
                
            } else {
                error "Unexpected switch value: $type"
            }
            set fun gen_loop
        }
    }
    return [ $fun $db $item_id $parent_loop ]
