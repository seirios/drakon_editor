    lappend result "package $pkgname is"
    lappend result "=== spec_footer ==="
    lappend result "end $pkgname;"
    lappend result "=== body_header ==="
    lappend result "package body $pkgname is"
    lappend result "=== body_footer ==="
    lappend result "end $pkgname;"
    return [ join $result "\n" ]
}

