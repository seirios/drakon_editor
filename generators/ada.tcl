proc p.replace_select_ifs { gdb select ordinals callbacks } {
    set diagram_id \
    	[ gen::p.vertex_diagram $gdb $select ]
    set select_item \
    	[ gen::p.vertex_item $gdb $select ]
    set select_icon_number $select_item
    set select_text \
    	[ gen::p.vertex_text $gdb $select ]
    set item_id [ expr { $select_item * 1000 } ]
    set sel_id [ gen::p.insert_vertex \
    	$gdb $diagram_id $item_id sel $select_text "" 0 ]
    gen::p.relink $gdb $select $sel_id
    set parent $sel_id
    set count [ llength $ordinals ]
    set last [ expr { $count - 1 } ]
    set i 0
    while { 1 } {
        if {$i < $count} {
            
        } else {
            break
        }
        set ordinal [ lindex $ordinals $i ]
        set const \
        	[ gen::p.link_const $gdb $select $ordinal ]
        set dst \
        	[ gen::p.link_dst $gdb $select $ordinal ]
        if {$i == $last && \
	($const == "" || $const == "others")} {
            incr item_id
            set others_id [ gen::p.insert_vertex \
            	$gdb $diagram_id $item_id action "others" "" 0 ]
            gen::p.link $gdb $parent 1 $others_id
            gen::p.link $gdb $others_id 1 $dst
        } else {
            set comp_text "$const"
            incr item_id
            set case_id [ gen::p.insert_vertex \
            	$gdb $diagram_id $item_id case $comp_text "" 0 ]
            if {$i == $last} {
                incr item_id
                set others_id [ gen::p.insert_vertex \
                	$gdb $diagram_id $item_id action "others" "" 0 ]
                gen::p.link $gdb $case_id 2 $dst
                gen::p.link $gdb $case_id 1 $others_id
                gen::p.link $gdb $others_id 1 $dst
            } else {
                gen::p.link $gdb $case_id 2 $dst
            }
            gen::p.link $gdb $parent 1 $case_id
            set parent $case_id
        }
        incr i
    }
    gen::p.unlink $gdb $select
    gen::p.delete_vertex $gdb $select
}

proc p.rewire_loop { gdb start callbacks } {
    set diagram_id [ gen::p.vertex_diagram $gdb $start ]
    set end [ gen::p.find_end $gdb $diagram_id $start ]
    set text [ gen::p.vertex_text $gdb $start ]
    set item_id [ gen::p.vertex_item $gdb $start ]
    set parts [ split $text ";" ]
    set scheme [ lindex $parts 0 ]
    set name [ string trim [ lindex $parts 1 ] ]
    if {[ string first "for " $scheme ] != -1} {
        set type "for"
    } else {
        if {[ string first "while " $scheme ] != -1} {
            set type "while"
        } else {
            set type ""
        }
    }
    if {($type == "for") || ($type == "while")} {
        p.rewire_loop_any $gdb $start $end $scheme $name
    } else {
        graph::p.error $diagram_id [ list $item_id ] \
        	"Error in loop statement: $text"
        gen::report_error $diagram_id $item_id \
        	"Error in loop item $item_id: $text"
    }
}

proc p.rewire_loop_any { gdb start end scheme name } {
    set diagram_id [ gen::p.vertex_diagram $gdb $start ]
    set item_id [ gen::p.vertex_item $gdb $start ]
    if {$name == ""} {
        
    } else {
        set scheme "$name :\n$scheme"
    }
    set loop_id [ \
    	gen::p.insert_vertex $gdb $diagram_id [ \
    		gen::append_digits $item_id 0001 ] \
    	"action" $scheme "" 0 ]
    set check_id [ \
    	gen::p.insert_vertex $gdb $diagram_id [ \
    		gen::append_digits $item_id 0002 ] \
    	"case" $name "" 0 ]
    set endloop_id [ \
    	gen::p.insert_vertex $gdb $diagram_id [ \
    		gen::append_digits $item_id 0003 ] \
    	"action" "" "" 0 ]
    set loop_body [ gen::p.get_next $gdb $start 2 ]
    set after_loop [ gen::p.get_next $gdb $start 1 ]
    gen::p.relink $gdb $start $loop_id
    gen::p.relink $gdb $end $endloop_id
    
    gen::p.link $gdb $loop_id 1 $check_id
    gen::p.link $gdb $check_id 1 $after_loop
    gen::p.link $gdb $check_id 2 $loop_body
    
    # loop!
    gen::p.link $gdb $endloop_id 1 $check_id
    $gdb eval {
    	delete from links where src = :start;
    	delete from vertices where vertex_id in (:start, :end);
    }
}

proc p.shelf { primary secondary } {
    set lines {}
    set plines [ split $primary "\n" ]
    set sterms [ split $secondary " " ]
    set _sw11330000_ [ lindex $sterms 0 ]
    if {$_sw11330000_ == "array"} {
        set result "array $primary"
    } else {
        if {$_sw11330000_ == "new"} {
            set result "new $primary"
        } else {
            if {$_sw11330000_ == "enum"} {
                set values [ join $plines ", " ]
                set result "($values)"
            } else {
                if {$_sw11330000_ == "when"} {
                    lappend lines "##@@BEGIN_WHEN@@##"
                    set lines [ concat $lines $plines ]
                    lappend lines "##@@END_WHEN@@##"
                    set result [ join $lines "\n" ]
                } else {
                    if {$_sw11330000_ == "record"} {
                        lappend lines "##@@BEGIN_RECORD@@##"
                        set lines [ concat $lines $plines ]
                        lappend lines "##@@END_RECORD@@##"
                        set result [ join $lines "\n" ]
                    } else {
                        if {$_sw11330000_ == "is"} {
                            lappend lines "##@@BEGIN_IS@@##"
                            set lines [ concat $lines $plines ]
                            lappend lines "##@@END_IS@@##"
                            set result [ join $lines "\n" ]
                        } else {
                            if {$_sw11330000_ == "with"} {
                                lappend lines "##@@BEGIN_WITH@@##"
                                set lines [ concat $lines $plines ]
                                lappend lines "##@@END_WITH@@##"
                                set result [ join $lines "\n" ]
                            } else {
                                if {$_sw11330000_ == "declare"} {
                                    set name [ lindex $sterms 1 ]
                                    if {$name != ""} {
                                        lappend lines "$name :"
                                    }
                                    lappend lines "##@@BEGIN_DECLARE@@##"
                                    set lines [ concat $lines $plines ]
                                    lappend lines "##@@END_DECLARE@@##"
                                    set result [ join $lines "\n" ]
                                } else {
                                    if {$_sw11330000_ == "for"} {
                                        lappend lines "##@@BEGIN_FOR@@##"
                                        lappend lines [ lrange $sterms 1 end ]
                                        set lines [ concat $lines $plines ]
                                        lappend lines "##@@END_FOR@@##"
                                        set result [ join $lines "\n" ]
                                    } else {
                                        if {$_sw11330000_ == "return"} {
                                            if {[ llength $sterms ] == 1} {
                                                set result "return $primary;"
                                            } else {
                                                lappend lines "##@@BEGIN_RETURN@@##"
                                                lappend lines [ lrange $sterms 1 end ]
                                                set lines [ concat $lines $plines ]
                                                lappend lines "##@@END_RETURN@@##"
                                                set result [ join $lines "\n" ]
                                            }
                                        } else {
                                            if {$_sw11330000_ == "end"} {
                                                
                                            } else {
                                                error "Unexpected switch value: $_sw11330000_"
                                            }
                                            lappend lines "##@@BEGIN_END@@##"
                                            append_notempty lines $primary
                                            lappend lines "##@@END_END@@##"
                                            set result [ join $lines "\n" ]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return $result
}

proc p.short_circuit { gdb callbacks diagram_id } {
    p.short_circuit_elems \
    	$gdb $callbacks $diagram_id "if"
    p.short_circuit_elems \
    	$gdb $callbacks $diagram_id "case"
}

proc p.short_circuit_elems { gdb callbacks diagram_id type } {
    if {$type == "if"} {
        set and [ gen::get_callback $callbacks and ]
        set or [ gen::get_callback $callbacks or ]
        set not [ gen::get_callback $callbacks not ]
    } else {
        set and [ gen::get_callback $callbacks case_and ]
        set or [ gen::get_callback $callbacks case_or ]
        set not [ gen::get_callback $callbacks case_not ]
    }
    set ifs [ $gdb eval {
    	select vertex_id
    	from vertices
    	where type = :type
    		and diagram_id = :diagram_id } ]
    set result 0
    foreach if_id $ifs {
        set text [ gen::p.vertex_text $gdb $if_id ]
        set one [ gen::p.link_dst $gdb $if_id 1 ]
        set two [ gen::p.link_dst $gdb $if_id 2 ]
        set one_type [ gen::p.v_type $gdb $one ]
        if {$one != $if_id
	&& $one_type == "$type"
	&& [ gen::p.has_one_entry $gdb $one ]} {
            set ctext [ gen::p.vertex_text $gdb $one ]
            set cone [ gen::p.link_dst $gdb $one 1 ]
            set ctwo [ gen::p.link_dst $gdb $one 2 ]
            if {$ctwo == $two} {
                set result 1
                gen::p.set_link_dst $gdb $if_id 1 $cone
                gen::p.unlink $gdb $one
                $gdb eval { delete from vertices where vertex_id = :one }
                set ntext [ $or $text $ctext ]
                gen::p.set_vertex_text $gdb $if_id $ntext
            } else {
                if {$cone == $two} {
                    set result 1
                    gen::p.set_link_dst $gdb $if_id 1 $ctwo
                    gen::p.unlink $gdb $one
                    $gdb eval { delete from vertices where vertex_id = :one }
                    set ntext [ $or $text [ $not $ctext ] ]
                    gen::p.set_vertex_text $gdb $if_id $ntext
                }
            }
        }
        set text [ gen::p.vertex_text $gdb $if_id ]
        set one [ gen::p.link_dst $gdb $if_id 1 ]
        set two [ gen::p.link_dst $gdb $if_id 2 ]
        set two_type [ gen::p.v_type $gdb $two ]
        if {$two != $if_id
	&& $two_type == "$type"
	&& [ gen::p.has_one_entry $gdb $two ]} {
            set ctext [ gen::p.vertex_text $gdb $two ]
            set cone [ gen::p.link_dst $gdb $two 1 ]
            set ctwo [ gen::p.link_dst $gdb $two 2 ]
            if {$cone == $one} {
                set result 1
                gen::p.set_link_dst $gdb $if_id 2 $ctwo
                gen::p.unlink $gdb $two
                $gdb eval { delete from vertices where vertex_id = :two }
                set ntext [ $and $text $ctext ]
                gen::p.set_vertex_text $gdb $if_id $ntext
            } else {
                if {$ctwo == $one} {
                    set result 1
                    gen::p.set_link_dst $gdb $if_id 2 $cone
                    gen::p.unlink $gdb $two
                    $gdb eval { delete from vertices where vertex_id = :two }
                    set ntext [ $and $text [ $not $ctext ] ]
                    gen::p.set_vertex_text $gdb $if_id $ntext
                }
            }
        }
        if {$result} {
            break
        }
    }
    return $result
}

