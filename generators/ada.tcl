proc monkey_patch { direction fnames } {
    foreach fname $fnames {
        if {$direction == "reverse"} {
            rename "$fname" "${fname}_ada"
            rename "${fname}_bkp" "$fname"
        } else {
            rename "$fname" "${fname}_bkp"
            rename "${fname}_ada" "$fname"
        }
    }
}

