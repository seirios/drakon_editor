proc shelf { primary secondary } {
    set lines {}
    set plines [ split $primary "\n" ]
    if {$secondary == "record"} {
        if {[ lindex $plines 0 ] == "null"} {
            set result "null record"
        } else {
            lappend lines "record"
            foreach line $plines {
                lappend lines "   $line;"
            }
            lappend lines "end record"
            set result [ join $lines "\n" ]
        }
    } else {
        if {$secondary == "is"} {
            lappend lines "##@@BEGIN_IS@@##"
            foreach line $plines {
                lappend lines "   $line"
            }
            lappend lines "##@@END_IS@@##"
            set result [ join $lines "\n" ]
        } else {
            if {$secondary == "with"} {
                lappend lines "##@@BEGIN_WITH@@##"
                foreach line $plines {
                    lappend lines "   $line"
                }
                lappend lines "##@@END_WITH@@##"
                set result [ join $lines "\n" ]
            } else {
                set result $primary
            }
        }
    }
    return $result
}

proc standard_color { keywords kw_types type text } {
    if {$type == "op"} {
        return $colors::syntax_operator
    } else {
        if {$type == "number"} {
            return $colors::syntax_number
        } else {
            if {$type == "token"} {
                if {[contains $kw_types $text]} {
                    return $colors::syntax_type
                } else {
                    if {[contains $keywords $text]} {
                        return $colors::syntax_keyword
                    } else {
                        return $colors::syntax_identifier
                    }
                }
            } else {
                return $colors::syntax_identifier
            }
        }
    }
}

proc tab_convert { convert_cb text } {
    if {$convert_cb == ""} {
        return $text
    } else {
        return [ regsub -all \t $text [ $convert_cb ] ]
    }
}

