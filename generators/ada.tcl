proc gen_case { db item_id } {
    set next0 [ nogoto::get_next_node $db $item_id 0 ]
    set next1 [ nogoto::get_next_node $db $item_id 1 ]
    set if_stop [ nogoto::get_node_if_stop $db $item_id ]
    set loop_break [ nogoto::get_node_loop_break $db $item_id ]
    set result [ list "case" $item_id ]
    lassign \
    [ nogoto::generate_if_seq \
    	$db $next0 $if_stop $loop_break "" ] \
    then_block after_then
    lassign \
    [ nogoto::generate_if_seq \
    	$db $next1 $if_stop $loop_break "" ] \
    else_block after_else
    if {($then_block == {}) || ($else_block == {})} {
        return {}
    } else {
        lappend result $then_block $else_block
        if {$after_then == ""} {
            set next $after_else
        } else {
            set next $after_then
        }
        return [ list $result $next ]
    }
}

proc gen_loop { db item_id } {
    set item [ nogoto::gen_loop $db $item_id "" ]
    set node [ lindex $item 0 ]
    set node [ if_break_to_exit_when $node ]
    lassign \
    [ remove_dummy_case $node ] \
    node name_id
    set pos [ lrange $node 1 end ]
    set pre [ list "loop" [ list "name" $name_id ] ]
    set node [ concat $pre $pos ]
    set item [ list $node [ lindex $item 1 ] ]
    return $item
}

proc gen_sel { db item_id } {
    set next0 [ nogoto::get_next_node $db $item_id 0 ]
    set inner [ generate_item $db $next0 "" ]
    set tree [ lindex $inner 0 ]
    set after [ lindex $inner 1 ]
    set cases [ case_tree_to_case_list $tree {} ]
    set cases [ concat {seq} $cases ]
    set result [ list "sel" $item_id $cases ]
    set item [ list $result $after ]
    return $item
}

proc generate { db gdb filename } {
    variable tdb
    do_monkey_patch
    set error_message ""
    set tdb $gdb
    set prefix [ string cat [ \
    	file dirname $filename ] "/" ]
    set trees [ tab::generate_trees $gdb ]
    foreach tree $trees {
        create_tree $prefix $tree
    }
    set callbacks [ make_callbacks ]
    set diagrams [ $gdb eval { \
    	select diagram_id from diagrams } ]
    foreach diagram_id $diagrams {
        if {[ mwc::is_drakon $diagram_id ]} {
            gen::fix_graph_for_diagram $gdb $callbacks 0 $diagram_id
        }
    }
    set sections \
    	{ spec_header spec_footer body_header body_footer }
    lassign \
    [ gen::scan_file_description $db $sections ] \
    spec_header spec_footer body_header body_footer
    set components [ gen::generate_functions \
    	$db $gdb $callbacks 1 ]
    if {[ graph::errors_occured ]} {
        
    } else {
        if {[ is_empty_spec \
	$components $spec_header $spec_footer ]} {
            
        } else {
            set spec_filename [ replace_extension $filename "ads" ]
            set sfile \
            [open_files [ list $spec_filename ] "w"]
            catch {
                print_spec $db $spec_filename $sfile $components \
            	$spec_header $spec_footer
            } error_message
            close_files [ list $sfile ]
        }
        if {$error_message == ""} {
            set body_filename [ replace_extension $filename "adb" ]
            set bfile \
            [open_files [ list $body_filename ] "w"]
            catch {
                print_body $db $body_filename $bfile $components \
            	$body_header $body_footer
            } error_message
            close_files [ list $bfile ]
        }
    }
    undo_monkey_patch
    if {$error_message == ""} {
        
    } else {
        puts $::errorInfo
        error $error_message
    }
}

proc generate_body { gdb diagram_id start_item node_list sorted incoming } {
    set callbacks \
    [ make_callbacks ]
    return [ cbody::generate_body \
                 $gdb \
                 $diagram_id \
                 $start_item \
                 $node_list \
                 $sorted \
                 $incoming \
                 $callbacks ]
}

proc generate_item { db item_id parent_loop } {
    set type [ nogoto::get_node_type $db $item_id ]
    if {$type == "action"} {
        return [ nogoto::gen_action \
        	$db $item_id $parent_loop ]
    } else {
        if {$type == "if"} {
            return [ nogoto::gen_if \
            	$db $item_id $parent_loop ]
        } else {
            if {$type == "loop"} {
                return [ gen_loop \
                	$db $item_id ]
            } else {
                if {$type == "case"} {
                    return [ gen_case \
                    	$db $item_id ]
                } else {
                    if {$type == "sel"} {
                        
                    } else {
                        error "Unexpected switch value: $type"
                    }
                    return [ gen_sel \
                    	$db $item_id ]
                }
            }
        }
    }
}

proc highlight { tokens } {
    variable ada_keywords
    variable ada_types
    set tokens [ preprocess_tokens $tokens ]
    return [ highlight_generic $ada_keywords $ada_types $tokens ]
}

proc highlight_generic { keywords kw_types tokens } {
    set result {}
    set state "idle"
    set ntok [ llength $tokens ]
    set i 0
    while { 1 } {
        if {$i < $ntok} {
            
        } else {
            break
        }
        set token [ lindex $tokens $i ]
        set inext [ expr { $i + 1 } ]
        set lookahead [ lindex $tokens $inext ]
        lassign \
        $token \
        type text
        if {$state == "idle"} {
            set state [ idle_default $keywords $kw_types \
            	result $type $text $lookahead ]
        } else {
            if {$state == "string"} {
                lappend result $colors::syntax_string
                if {($text == "\"") || ($text == "\n")} {
                    set state "idle"
                }
            } else {
                if {$state == "comment line"} {
                    
                } else {
                    error "Unexpected switch value: $state"
                }
                lappend result \
                	$colors::syntax_comment
                if {$text == "\n"} {
                    set state "idle"
                }
            }
        }
        incr i
    }
    if {$state == "comment start"} {
        lappend result $colors::syntax_operator
    }
    return $result
}

proc idle_default { keywords kw_types result_name type text lookahead } {
    upvar 1 $result_name result
    set delims {
    	"(" ")" "[" "]" ";" }
    set consts {
    	True False }
    if {$text == "\""} {
        lappend result $colors::syntax_string
        set state "string"
    } else {
        if {$text == "--"} {
            lappend result \
            	$colors::syntax_comment
            set state "comment line"
        } else {
            if {$type == "token"} {
                if {[contains $kw_types $text]} {
                    set type "type"
                } else {
                    if {[contains $keywords $text]} {
                        set type "keyword"
                    } else {
                        if {[contains $consts $text]} {
                            set type "const"
                        } else {
                            set type "id"
                        }
                    }
                }
            } else {
                if {$type == "op" &&
	[ contains $delims $text ]} {
                    set type "delim"
                }
            }
            lappend result [standard_color \
            	$keywords $kw_types $type $text]
            set state "idle"
        }
    }
    return $state
}

proc if_break_to_exit_when { node } {
    set result {}
    foreach elem $node {
        set type [ lindex $elem 0 ]
        if {$type == "if"} {
            lassign \
            $elem \
            type cond_part else_part then_part
            if {$else_part == "seq" &&
	$then_part == {seq break}} {
                lappend result [ list "exit" $cond_part 0 ]
            } else {
                if {$then_part == "seq" &&
	$else_part == {seq break}} {
                    lappend result [ list "exit" $cond_part 1 ]
                } else {
                    lappend result $elem
                }
            }
        } else {
            lappend result $elem
        }
    }
    return $result
}

