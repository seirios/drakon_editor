proc p.rewire_loop { gdb start callbacks } {
    set diagram_id [ gen::p.vertex_diagram $gdb $start ]
    set end [ gen::p.find_end $gdb $diagram_id $start ]
    set text [ gen::p.vertex_text $gdb $start ]
    set item_id [ gen::p.vertex_item $gdb $start ]
    set parts [ split $text ";" ]
    set scheme [ lindex $parts 0 ]
    set ident [ lindex $parts 1 ]
    if {$scheme == ""} {
        set type "loop"
    } else {
        if {[ string first "for " $scheme ] != -1} {
            set type "for"
        } else {
            if {[ string first "while " $scheme ] != -1} {
                set type "while"
            } else {
                set type ""
            }
        }
    }
    if {(($type == "loop") || ($type == "for")) || ($type == "while")} {
        p.rewire_loop_any $gdb $start $end $scheme $ident
    } else {
        graph::p.error $diagram_id [ list $item_id ] \
        	"Error in loop statement: $text"
        gen::report_error $diagram_id $item_id \
        	"Error in loop item $item_id: $text"
    }
}

proc p.rewire_loop_any { gdb start end scheme ident } {
    set diagram_id [ gen::p.vertex_diagram $gdb $start ]
    set item_id [ gen::p.vertex_item $gdb $start ]
    set loop_id [ \
    	gen::p.insert_vertex $gdb $diagram_id [ \
    		gen::append_digits $item_id 0001 ] \
    	"action" $scheme "" 0 ]
    set check_id [ \
    	gen::p.insert_vertex $gdb $diagram_id [ \
    		gen::append_digits $item_id 0002 ] \
    	"if" "" "" 0 ]
    set endloop_id [ \
    	gen::p.insert_vertex $gdb $diagram_id [ \
    		gen::append_digits $item_id 0003 ] \
    	"action" "" "" 0 ]
    set loop_body [ gen::p.get_next $gdb $start 2 ]
    set after_loop [ gen::p.get_next $gdb $start 1 ]
    gen::p.relink $gdb $start $loop_id
    gen::p.link $gdb $loop_id 1 $check_id
    gen::p.relink $gdb $end $endloop_id
    gen::p.link $gdb $endloop_id 1 $check_id
    
    gen::p.link $gdb $check_id 1 $after_loop
    gen::p.link $gdb $check_id 2 $loop_body
    $gdb eval {
    	delete from links where src = :start;
    	delete from vertices where vertex_id in (:start, :end);
    }
}

proc package_name { filename } {
    set name [ string tolower $filename ]
    set name [ string replace $name [ string last .drn $name ] end ]
    set name [ string toupper $name 0 ]
    set index [ string first _ $name]
    while { 1 } {
        if {$index != -1} {
            
        } else {
            break
        }
        set name [ string toupper $name $index+1 ]
        set index [ string first _ $name $index+1 ]
    }
    set index [ string first - $name]
    while { 1 } {
        if {$index != -1} {
            
        } else {
            break
        }
        set name [ string toupper $name $index+1 ]
        set name [ string replace $name $index $index . ]
        set index [ string first - $name $index+1 ]
    }
    return $name
}

proc print_body { db filename fhandle components header footer } {
    put_credits $fhandle
    puts $fhandle $header
    foreach subprogram [ filter_subprograms $components 1 static ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    foreach subprogram [ filter_subprograms $components 0 static ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    foreach subprogram [ filter_subprograms $components 0 public ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    foreach subprogram [ filter_subprograms $components 0 private ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    puts $fhandle $footer
}

proc print_node_core { texts node callbacks depth break_var } {
    set line_end [ gen::get_optional_callback $callbacks line_end ]
    set commentator [ gen::get_callback $callbacks comment ]
    set break_str [ gen::get_callback $callbacks break ]
    set native_foreach [ gen::get_optional_callback $callbacks native_foreach ]
    set tab_convert [ gen::get_optional_callback $callbacks tab_convert ]
    
    set block_close [ gen::get_callback $callbacks block_close ]
    set if_close [ gen::get_optional_callback $callbacks if_close ]
    set while_start [ gen::get_callback $callbacks while_start ]
    set else_start [ gen::get_callback $callbacks else_start ]
    set pass [ gen::get_callback $callbacks pass ]
    
    set assign [ gen::get_callback $callbacks assign ]
    set compare [ gen::get_callback $callbacks compare ]
    set declare [ gen::get_callback $callbacks declare ]
    set length [ llength $node ]
    set result {}
    set was_return 0
    set indent [ gen::make_indent $depth ]
    set next_depth [ expr { $depth + 1 } ]
    set i 1
    while { 1 } {
        if {$i < $length} {
            
        } else {
            break
        }
        set current [ lindex $node $i ]
        if {[ string is integer $current ]} {
            set text [ tab_convert $tab_convert \
            	[ gen::get_text_lines $texts $current ] ]
            set parts [ split $text "\n" ]
            if {[ llength $parts ] == 0} {
                
            } else {
                gen::append_line_end result $i $line_end
            }
            foreach part $parts {
                set line $indent$part
                lappend result $line
            }
        } else {
            set _sw17540000_ [ lindex $current 0 ]
            if {$_sw17540000_ == "if"} {
                set cond_item [ lindex $current 1 ]
                set cond_text [ tab_convert $tab_convert \
                	[ gen::get_text_lines $texts $cond_item ] ]
                set cond [ gen::condition_line $callbacks $cond_text ]
                lappend result $indent$cond
                set then_node [ lindex $current 3 ]
                set else_node [ lindex $current 2 ]
                set then [ print_node_core \
                	$texts $then_node $callbacks $next_depth $break_var ]
                set result [ concat $result $then ]
                if {$else_node == "seq"} {
                    
                } else {
                    lappend result "$indent[ $else_start ]"
                    set else [ print_node_core \
                    	$texts $else_node $callbacks $next_depth $break_var ]
                    set result [ concat $result $else ]
                }
                $if_close result $depth
            } else {
                if {$_sw17540000_ == "loop"} {
                    set early_var ""
                    set body [ gen::print_node_core \
                    	$texts $current $callbacks $next_depth $early_var ]
                    lappend result "${indent}loop"
                    set result [ concat $result $body ]
                    lappend result "${indent}end loop;"
                } else {
                    if {$_sw17540000_ == "exit"} {
                        set cond_item [ lindex $current 1 ]
                        set cond_text [ tab_convert $tab_convert \
                        	[ gen::get_text_lines $texts $cond_item ] ]
                        set cond_lines [ split $cond_text "\n" ]
                        set nline [ llength $cond_lines ]
                        set first_cond [ lindex $cond_lines 0 ]
                        set line "${indent}exit when $first_cond"
                        if {$nline == 1} {
                            append line ";"
                        }
                        lappend result $line
                        set ili 1
                        while { 1 } {
                            if {$ili < $nline} {
                                
                            } else {
                                break
                            }
                            set current [ lindex $cond_lines $ili ]
                            set line "$indent$current"
                            if {$ili == $nline - 1} {
                                append line ";"
                            }
                            lappend result $line
                            incr ili
                        }
                    } else {
                        if {$_sw17540000_ == "sel"} {
                            
                        } else {
                            error "Unexpected switch value: $_sw17540000_"
                        }
                    }
                }
            }
        }
        incr i
    }
    if {$result == ""} {
        set result [ list "$indent[ $pass ]" ]
    }
    return $result
}

proc print_spec { db filename fhandle components header footer } {
    put_credits $fhandle
    puts $fhandle $header
    foreach type [ filter_types $components -1 ] {
        print_type $fhandle $type
    }
    foreach type [ filter_types $components 0 ] {
        print_type $fhandle $type
    }
    foreach type [ filter_types $components +1 ] {
        print_type $fhandle $type
    }
    foreach subprogram [ filter_subprograms $components 1 public ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    foreach subprogram [ filter_subprograms $components 0 public ] {
        print_subprogram $db $fhandle $subprogram 1
    }
    if {[ llength \
	[ filter_subprograms \
	$components 0 private ] ] == 0} {
        
    } else {
        puts $fhandle ""
        puts $fhandle "private"
        foreach subprogram [ filter_subprograms $components 0 private ] {
            print_subprogram $db $fhandle $subprogram 1
        }
    }
    puts $fhandle $footer
}

proc print_subprogram { db fhandle component in_header } {
    lassign \
    $component \
    diagram_id name signature body
    lassign \
    $signature \
    type prop_list parameters returns
    array set props $prop_list
    set sections {
    	spec_header spec_footer body_header body_footer }
    lassign \
    [ gen::scan_diagram_description $db $diagram_id $sections ] \
    spec_header spec_footer body_header body_footer
    if {$props(abstract) && !$in_header} {
        
    } else {
        set static [ expr { $props(access) != "public" } ]
        set print_body [ expr !$in_header ]
        set depth 1
        print_subprogram_kernel \
        $fhandle \
        $depth \
        $static \
        $props(subtype) \
        $props(inline) \
        $props(abstract) \
        $returns \
        $name \
        $parameters \
        $body \
        $print_body \
        $spec_header \
        $spec_footer \
        $body_header \
        $body_footer
    }
}

proc print_subprogram_kernel { fhandle depth static type inline abstract returns name parameters body print_body spec_header spec_footer body_header body_footer } {
    set result {}
    set line ""
    if {$print_body} {
        append_notempty \
        	result $body_header
    } else {
        append_notempty \
        	result $spec_header
    }
    append line "$type"
    append line " $name"
    set param_count [ llength $parameters ]
    if {$param_count == 0} {
        
    } else {
        append line " \("
        lappend result $line
        set i 0
        while { 1 } {
            if {$i < $param_count} {
                
            } else {
                break
            }
            set parameter_info [ lindex $parameters $i ]
            set parameter [ lindex $parameter_info 0 ]
            set line "   $parameter"
            if {$i == $param_count - 1} {
                
            } else {
                append line ";"
            }
            lappend result $line
            incr i
        }
        set line "\)"
    }
    if {$type == "function"} {
        append line " return $returns"
    }
    lappend result $line
    if {$abstract} {
        lappend result "is abstract"
    } else {
        if {$print_body} {
            set body [ handle_is result $body ]
            lappend result "begin"
            foreach line $body {
                lappend result "   $line"
            }
            lappend result "end $name"
        }
    }
    if {$print_body} {
        append_notempty \
        	result $body_footer
    } else {
        append_notempty \
        	result $spec_footer
    }
    set space [ gen::make_indent $depth ]
    set nline [ llength $result ]
    set i 0
    while { 1 } {
        if {$i < $nline} {
            
        } else {
            break
        }
        puts -nonewline $fhandle $space
        if {$i == $nline - 1} {
            puts -nonewline $fhandle [ lindex $result $i ]
            puts $fhandle ";"
        } else {
            puts $fhandle [ lindex $result $i ]
        }
        incr i
    }
    puts $fhandle ""
}

proc print_type { fhandle component } {
    lassign \
    $component \
    diagram_id name signature body
    lassign \
    $signature \
    type prop_list parameters returns
    array set props $prop_list
    set depth 1
    set has_body 1
    print_type_kernel \
    $fhandle \
    $depth \
    $props(subtype) \
    $props(abstract) \
    $props(tagged) \
    $name \
    $body \
    $has_body
}

proc print_type_kernel { fhandle depth type abstract tagged name body has_body } {
    set result {}
    set line ""
    append line "$type "
    append line "$name "
    append line "is"
    if {$abstract} {
        append line " abstract"
    }
    if {$tagged} {
        append line " tagged"
    }
    lappend result $line
    if {$has_body} {
        foreach line $body {
            lappend result "   $line"
        }
    }
    set space [ gen::make_indent $depth ]
    set nline [ llength $result ]
    set i 0
    while { 1 } {
        if {$i < $nline} {
            
        } else {
            break
        }
        puts -nonewline $fhandle $space
        if {$i == $nline - 1} {
            puts -nonewline $fhandle [ lindex $result $i ]
            puts $fhandle ";"
        } else {
            puts $fhandle [ lindex $result $i ]
        }
        incr i
    }
    puts $fhandle ""
}

