proc package_name { filename } {
    set name [ string tolower $filename ]
    set name [ string replace $name [ string last .drn $name ] end ]
    set name [ string toupper $name 0 ]
    set index [ string first _ $name]
    while { 1 } {
        if {$index != -1} {
            
        } else {
            break
        }
        set name [ string toupper $name $index+1 ]
        set index [ string first _ $name $index+1 ]
    }
    set index [ string first - $name]
    while { 1 } {
        if {$index != -1} {
            
        } else {
            break
        }
        set name [ string toupper $name $index+1 ]
        set name [ string replace $name $index $index . ]
        set index [ string first - $name $index+1 ]
    }
    return $name
}

proc parse_body { body depth name } {
    set result {}
    set indent [ gen::make_indent $depth ]
    set nline [ llength $body ]
    set i 0
    while { 1 } {
        if {$i < $nline} {
            
        } else {
            break
        }
        set line [ lindex $body $i ]
        if {$line == "##@@BEGIN_DECLARE@@##"} {
            incr i
            lassign \
            [ collect_until $body $i "##@@END_DECLARE@@##" 0 ] \
            i lines
            lappend result "${indent}declare"
            incr_indent indent depth
            foreach line $lines {
                lappend result "${indent}$line"
            }
            decr_indent indent depth
            lappend result "${indent}begin"
            incr_indent indent depth
        } else {
            if {$line == "##@@BEGIN_END@@##"} {
                incr i
                lassign \
                [ collect_until $body $i "##@@END_END@@##" 0 ] \
                i lines
                if {[ llength $lines ] > 0} {
                    set loopname [ lindex $lines 0 ]
                    set loopname " $loopname"
                } else {
                    set loopname ""
                }
                decr_indent indent depth
                lappend result "${indent}end${loopname};"
            } else {
                if {$line == "##@@BEGIN_WITH@@##"} {
                    lassign \
                    [ multi_extract $body $i \
                    	"##@@BEGIN_WITH@@##" "##@@END_WITH@@##" 0 ] \
                    i with_lines
                    set lines [ join_lists $with_lines "," ]
                    set lines [ indent_group $lines "with" $depth "" ]
                    foreach line $lines {
                        lappend result $line
                    }
                } else {
                    if {$line == "##@@BEGIN_RECORD@@##"} {
                        incr i
                        lassign \
                        [ collect_until $body $i "##@@END_RECORD@@##" 0 ] \
                        i lines
                        set first [ lindex $lines 0 ]
                        if {$first == "" || $first == "null"} {
                            lappend result "${indent}null record"
                        } else {
                            lappend result "${indent}record"
                            incr_indent indent depth
                            foreach line $lines {
                                lappend result "${indent}$line"
                            }
                            decr_indent indent depth
                            lappend result "${indent}end record"
                        }
                    } else {
                        if {$line == "##@@BEGIN_FOR@@##"} {
                            incr i
                            lassign \
                            [ collect_until $body $i "##@@END_FOR@@##" 0 ] \
                            i for_lines
                            add_last_semicolon result
                            set elem [ lindex $for_lines 0 ]
                            set elem [ subst_at $elem $name ]
                            set use_clause [ lrange $for_lines 1 end ]
                            set lines [ join $use_clause " " ]
                            lappend result "for $elem $lines"
                        } else {
                            if {$line == "##@@BEGIN_RETURN@@##"} {
                                incr i
                                lassign \
                                [ collect_until $body $i "##@@END_RETURN@@##" 0 ] \
                                i return_lines
                                set first [ lindex $return_lines 0 ]
                                set lines [ lrange $return_lines 1 end ]
                                lappend result "${indent}return $first do"
                                incr_indent indent depth
                                foreach line $lines {
                                    lappend result "${indent}$line"
                                }
                                decr_indent indent depth
                                lappend result "${indent}end return;"
                            } else {
                                lappend result "${indent}$line"
                            }
                        }
                    }
                }
            }
        }
        incr i
    }
    return $result
}

proc preprocess_tokens { tokens } {
    set result {}
    set ntok [ llength $tokens ]
    set i 0
    while { 1 } {
        if {$i < $ntok} {
            
        } else {
            break
        }
        set token [ lindex $tokens $i ]
        lassign \
        $token \
        type text
        if {$type == "op"} {
            set inext [ expr { $i + 1 } ]
            set lookahead [ lindex $tokens $inext ]
            lassign \
            $lookahead \
            lahtype lahtext
            set inext2 [ expr { $i + 2 } ]
            set lookahead2 [ lindex $tokens $inext2 ]
            lassign \
            $lookahead2 \
            lahtype2 lahtext2
            if {$text == "-" &&
	$lahtype == "op" && $lahtext == "-"} {
                incr i
                set tok [ list $type "--" ]
                lappend result $tok $tok
            } else {
                if {$text == "'" &&
	$lahtype == "token" &&
	$lahtext2 != "'"} {
                    incr i
                    set tok [ list "attr" $lahtext ]
                    lappend result $token $tok
                } else {
                    if {$text == "'" &&
	$lahtype == "token" &&
	$lahtype2 == "op" && $lahtext2 == "'"} {
                        incr i 2
                        set tok [ list "char" $lahtext ]
                        lappend result $tok $tok $tok
                    } else {
                        lappend result $token
                    }
                }
            }
        } else {
            lappend result $token
        }
        incr i
    }
    return $result
}

proc print_body { db filename fhandle components header footer } {
    put_credits $fhandle
    puts_notempty \
    	$fhandle $header
    foreach subprogram [ filter_subprograms $components 1 static ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    foreach subprogram [ filter_subprograms $components 0 static ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    foreach subprogram [ filter_subprograms $components 0 public ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    foreach subprogram [ filter_subprograms $components 0 private ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    puts_notempty \
    	$fhandle $footer
}

proc print_node_core { texts node callbacks depth } {
    set tab_convert [ gen::get_optional_callback $callbacks tab_convert ]
    
    set if_close [ gen::get_if_close $callbacks ]
    set else_start [ gen::get_callback $callbacks else_start ]
    set pass [ gen::get_callback $callbacks pass ]
    set length [ llength $node ]
    set result {}
    set was_return 0
    set indent [ gen::make_indent $depth ]
    set next_depth [ expr { $depth + 1 } ]
    set i 1
    while { 1 } {
        if {$i < $length} {
            
        } else {
            break
        }
        set current [ lindex $node $i ]
        if {[ string is integer $current ]} {
            set text [ gen::get_text_lines $texts $current ]
            set text [ tab_convert $tab_convert $text ]
            set parts [ split $text "\n" ]
            foreach part $parts {
                lappend result "${indent}$part"
            }
        } else {
            set _sw17540000_ [ lindex $current 0 ]
            if {$_sw17540000_ == "if"} {
                set cond_item [ lindex $current 1 ]
                set cond_text [ gen::get_text_lines $texts $cond_item ]
                set cond_text [ tab_convert $tab_convert $cond_text ]
                set cond [ gen::condition_line $callbacks $cond_text ]
                lappend result "${indent}$cond"
                set then_node [ lindex $current 3 ]
                set else_node [ lindex $current 2 ]
                set then [ print_node_core \
                	$texts $then_node $callbacks $next_depth ]
                set result [ concat $result $then ]
                if {$else_node == "seq"} {
                    
                } else {
                    lappend result "$indent[ $else_start ]"
                    set else [ print_node_core \
                    	$texts $else_node $callbacks $next_depth ]
                    set result [ concat $result $else ]
                }
                $if_close result $depth
            } else {
                if {$_sw17540000_ == "loop"} {
                    set name_node [ lindex $current 1 ]
                    set name_item [ lindex $name_node 1 ]
                    set current [ lremove $current 1 ]
                    if {$name_item == ""} {
                        set name ""
                    } else {
                        set name [ gen::get_text_lines \
                        	$texts $name_item ]
                    }
                    set body [ print_node_core \
                    	$texts $current $callbacks $next_depth ]
                    set loop_stmt [ loop_statement $name $body $depth ]
                    set result [ concat $result $loop_stmt ]
                } else {
                    if {$_sw17540000_ == "exit"} {
                        set cond_item [ lindex $current 1 ]
                        set negate [ lindex $current 2 ]
                        set cond_text [ gen::get_text_lines $texts $cond_item ]
                        set cond_text [ tab_convert $tab_convert $cond_text ]
                        set exit_stmt [ exit_statement \
                        	$cond_text $negate $depth ]
                        set result [ concat $result $exit_stmt ]
                    } else {
                        if {$_sw17540000_ == "break"} {
                            lappend result "${indent}exit;"
                        } else {
                            if {$_sw17540000_ == "sel"} {
                                set var_item [ lindex $current 1 ]
                                set cases [ lindex $current 2 ]
                                set var_text [ gen::get_text_lines \
                                	$texts $var_item ]
                                lappend result "${indent}case $var_text is"
                                set body [ print_node_core \
                                	$texts $cases $callbacks $depth ]
                                set result [ concat $result $body ]
                                lappend result "${indent}end case;"
                            } else {
                                if {$_sw17540000_ == "case"} {
                                    
                                } else {
                                    error "Unexpected switch value: $_sw17540000_"
                                }
                                set cond_item [ lindex $current 1 ]
                                set actions [ lindex $current 2 ]
                                set cond_text [ gen::get_text_lines \
                                	$texts $cond_item ]
                                set when_text [ when_line $cond_text ]
                                lappend result "${indent}$when_text"
                                set body [ print_node_core \
                                	$texts $actions $callbacks $next_depth ]
                                set result [ concat $result $body ]
                            }
                        }
                    }
                }
            }
        }
        incr i
    }
    if {$result == ""} {
        set result [ list "$indent[ $pass ]" ]
    }
    return $result
}

proc print_spec { db filename fhandle components header footer } {
    put_credits $fhandle
    puts_notempty \
    	$fhandle $header
    foreach type [ filter_types $components -2 ] {
        print_type $db $fhandle $type
    }
    foreach type [ filter_types $components -1 ] {
        print_type $db $fhandle $type
    }
    foreach type [ filter_types $components 0 ] {
        print_type $db $fhandle $type
    }
    foreach subprogram [ filter_subprograms $components 1 public ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    foreach subprogram [ filter_subprograms $components 0 public ] {
        print_subprogram $db $fhandle $subprogram 1
    }
    if {[ llength \
	[ filter_subprograms \
	$components 0 private ] ] == 0} {
        
    } else {
        puts $fhandle ""
        puts $fhandle "private"
        foreach subprogram [ filter_subprograms $components 0 private ] {
            print_subprogram $db $fhandle $subprogram 1
        }
    }
    puts_notempty \
    	$fhandle $footer
}

proc print_subprogram { db fhandle component in_header } {
    lassign \
    $component \
    diagram_id name signature body
    lassign \
    $signature \
    type prop_list parameters returns
    array set props $prop_list
    set sections {
    	spec_header spec_footer body_header body_footer }
    lassign \
    [ gen::scan_diagram_description $db $diagram_id $sections ] \
    spec_header spec_footer body_header body_footer
    if {$props(abstract) && !$in_header} {
        
    } else {
        set static [ expr { $props(access) != "public" } ]
        set print_body [ expr !$in_header ]
        set depth 1
        print_subprogram_kernel \
        $fhandle \
        $depth \
        $static \
        $props(subtype) \
        $props(inline) \
        $props(abstract) \
        $props(overriding) \
        $returns \
        $name \
        $parameters \
        $body \
        $print_body \
        $spec_header \
        $spec_footer \
        $body_header \
        $body_footer
    }
}

proc print_subprogram_kernel { fhandle depth static type inline abstract overriding returns name parameters body print_body spec_header spec_footer body_header body_footer } {
    set result {}
    set line ""
    set indent \
    	[ gen::make_indent $depth ]
    if {$print_body} {
        append_notempty \
        	result $body_header
    } else {
        append_notempty \
        	result $spec_header
    }
    puts $fhandle ""
    if {$overriding == 0} {
        
    } else {
        if {$overriding == 1} {
            puts $fhandle "${indent}overriding"
        } else {
            puts $fhandle "${indent}not overriding"
        }
    }
    append line "$type"
    append line " $name"
    set param_count [ llength $parameters ]
    if {$param_count == 0} {
        
    } else {
        append line " \("
        lappend result $line
        set i 0
        while { 1 } {
            if {$i < $param_count} {
                
            } else {
                break
            }
            set parameter_info [ lindex $parameters $i ]
            set parameter [ lindex $parameter_info 0 ]
            set line "${indent}$parameter"
            if {$i == $param_count - 1} {
                
            } else {
                append line ";"
            }
            lappend result $line
            incr i
        }
        set line "\)"
    }
    if {$type == "function"} {
        append line " return $returns"
    }
    lappend result $line
    if {$abstract} {
        lappend result "is abstract"
    } else {
        if {$print_body} {
            lassign \
            [ extract_is $body ] \
            body is_lines
            if {[ llength $is_lines ] == 0} {
                lappend result "is begin"
                set body [ parse_body \
                	$body $depth $name ]
                foreach line $body {
                    lappend result $line
                }
                lappend result "end $name"
            } else {
                lappend result "is"
                foreach line $is_lines {
                    lappend result "${indent}$line"
                }
                if {[ llength $body ] == 0} {
                    
                } else {
                    lappend result "begin"
                    set body [ parse_body \
                    	$body $depth $name ]
                    foreach line $body {
                        lappend result $line
                    }
                    lappend result "end $name"
                }
            }
        }
    }
    if {$print_body} {
        append_notempty \
        	result $body_footer
    } else {
        append_notempty \
        	result $spec_footer
    }
    set nline [ llength $result ]
    set i 0
    while { 1 } {
        if {$i < $nline} {
            
        } else {
            break
        }
        puts -nonewline $fhandle $indent
        if {$i == $nline - 1} {
            puts -nonewline $fhandle [ lindex $result $i ]
            puts $fhandle ";"
        } else {
            puts $fhandle [ lindex $result $i ]
        }
        incr i
    }
}

proc print_type { db fhandle component } {
    lassign \
    $component \
    diagram_id name signature body
    lassign \
    $signature \
    type prop_list parameters returns
    array set props $prop_list
    set sections {
    	spec_header spec_footer body_header body_footer }
    lassign \
    [ gen::scan_diagram_description $db $diagram_id $sections ] \
    spec_header spec_footer body_header body_footer
    set depth 1
    set print_body 1
    print_type_kernel \
    $fhandle \
    $depth \
    $props(subtype) \
    $props(abstract) \
    $props(tagged) \
    $name \
    $body \
    $print_body \
    $spec_header \
    $spec_footer \
    $body_header \
    $body_footer
}

proc print_type_kernel { fhandle depth type abstract tagged name body print_body spec_header spec_footer body_header body_footer } {
    set result {}
    set line ""
    set indent \
    	[ gen::make_indent $depth ]
    if {$print_body} {
        append_notempty \
        	result $body_header
    } else {
        append_notempty \
        	result $spec_header
    }
    puts $fhandle ""
    append line "$type"
    append line " $name"
    append line " is"
    if {$abstract} {
        append line " abstract"
    }
    if {$tagged} {
        append line " tagged"
    }
    lappend result $line
    if {$print_body} {
        set body [ parse_body \
        	$body $depth $name ]
        foreach line $body {
            lappend result $line
        }
        if {$print_body} {
            append_notempty \
            	result $body_footer
        } else {
            append_notempty \
            	result $spec_footer
        }
    }
    set nline [ llength $result ]
    set i 0
    while { 1 } {
        if {$i < $nline} {
            
        } else {
            break
        }
        puts -nonewline $fhandle $indent
        if {$i == $nline - 1} {
            puts -nonewline $fhandle [ lindex $result $i ]
            puts $fhandle ";"
        } else {
            puts $fhandle [ lindex $result $i ]
        }
        incr i
    }
}

proc put_credits { fhandle } {
    set version [ version_string ]
    puts $fhandle [ p.comment "Autogenerated with DRAKON Editor $version" ]
}

proc puts_notempty { fhandle text } {
    if {$text == ""} {
        
    } else {
        puts $fhandle $text
    }
}

proc remove_dummy_case { node } {
    set first [ lindex $node 1 ]
    if {[ lindex $first 0 ] == "case"} {
        set name [ lindex $first 1 ]
        set node [ lremove $node 1 ]
    } else {
        set name ""
    }
    return [ list $node $name ]
}

proc select_ifs_and_cases { db } {
    return [ $db eval {
    	select item_id
    	from nodes
    	where type = 'if'
    	   or type = 'case' } ]
}

proc single_extract { body ifirst beginstr endstr do_unindent } {
    set lines {}
    set i $ifirst
    set first [ lindex $body $i ]
    if {[ unindent $first ] == $beginstr} {
        incr i
        lassign \
        [ collect_until $body $i $endstr $do_unindent ] \
        i lines
        incr i
    }
    return [ list $i $lines ]
}

proc standard_color { keywords kw_types type text } {
    if {$type == "op"} {
        return $colors::syntax_operator
    } else {
        if {$type == "number"} {
            return $colors::syntax_number
        } else {
            if {$type == "type"} {
                return $colors::syntax_type
            } else {
                if {$type == "keyword"} {
                    return $colors::syntax_keyword
                } else {
                    if {$type == "const"} {
                        return $colors::syntax_number
                    } else {
                        if {$type == "delim"} {
                            return $colors::syntax_delimiter
                        } else {
                            if {$type == "char"} {
                                return $colors::syntax_string
                            } else {
                                if {$type == "attr"} {
                                    return $colors::syntax_call
                                } else {
                                    return $colors::syntax_identifier
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

proc subst_at { str sub } {
    set loc [ string first "@" $str ]
    if {$loc == -1} {
        
    } else {
        set str [string replace \
        	$str $loc $loc $sub ]
    }
    return $str
}

proc tab_convert { convert_cb text } {
    if {$convert_cb == ""} {
        return $text
    } else {
        return [ regsub -all \t $text [ $convert_cb ] ]
    }
}

proc traverse_links { gdb id } {
    if {$id == ""} {
        
    } else {
        set d1 [ gen::p.link_dst $gdb $id 1 ]
        set d2 [ gen::p.link_dst $gdb $id 2 ]
        puts "$id -> d1: $d1; d2: $d2"
        traverse_links $gdb $d1
        traverse_links $gdb $d2
    }
}

proc undo_monkey_patch { } {
    set direction "reverse"
    monkey_patch_gen $direction
    monkey_patch_nogoto $direction
}

proc unindent { str } {
    return [ string trimleft $str ]
}

proc when_line { cond_text } {
    set when_start "when "
    set when_end " =>"
    set cond "${when_start}$cond_text${when_end}"
    return $cond
}

