proc print_body { db filename fhandle components header footer } {
    put_credits $fhandle
    puts $fhandle $header
    foreach subprogram [ filter_subprograms $components 1 static ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    foreach subprogram [ filter_subprograms $components 0 static ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    foreach subprogram [ filter_subprograms $components 0 public ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    foreach subprogram [ filter_subprograms $components 0 private ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    puts $fhandle $footer
}

proc print_spec { db filename fhandle components header footer } {
    put_credits $fhandle
    puts $fhandle $header
    foreach type [ filter_types $components -1 ] {
        print_type $fhandle $type
    }
    foreach type [ filter_types $components 0 ] {
        print_type $fhandle $type
    }
    foreach type [ filter_types $components +1 ] {
        print_type $fhandle $type
    }
    foreach subprogram [ filter_subprograms $components 1 public ] {
        print_subprogram $db $fhandle $subprogram 0
    }
    foreach subprogram [ filter_subprograms $components 0 public ] {
        print_subprogram $db $fhandle $subprogram 1
    }
    if {[ llength \
	[ filter_subprograms \
	$components 0 private ] ] == 0} {
        
    } else {
        puts $fhandle ""
        puts $fhandle "private"
        foreach subprogram [ filter_subprograms $components 0 private ] {
            print_subprogram $db $fhandle $subprogram 1
        }
    }
    puts $fhandle $footer
}

proc print_subprogram { db fhandle component in_header } {
    lassign $component diagram_id name signature body
    lassign $signature type prop_list parameters returns
    array set props $prop_list
    set sections [ get_sections ]
    lassign [ gen::scan_diagram_description $db $diagram_id $sections ] \
      spec_header spec_footer body_header body_footer
    if {$props(abstract) && !$in_header} {
        
    } else {
        set static [ expr { $props(access) != "public" } ]
        set print_body [ expr !$in_header ]
        set depth 1
        print_subprogram_kernel \
        $fhandle \
        $depth \
        $static \
        $props(subtype) \
        $props(inline) \
        $props(abstract) \
        $returns \
        $name \
        $parameters \
        $body \
        $print_body \
        $spec_header \
        $spec_footer \
        $body_header \
        $body_footer
    }
}

proc print_subprogram_kernel { fhandle depth static type inline abstract returns name parameters body print_body spec_header spec_footer body_header body_footer } {
    set result {}
    set line ""
    if {$print_body} {
        append_notempty \
        	result $body_header
    } else {
        append_notempty \
        	result $spec_header
    }
    append line "$type "
    append line "$name "
    set param_count [ llength $parameters ]
    if {$param_count == 0} {
        
    } else {
        append line "\("
        lappend result $line
        set i 0
        while { 1 } {
            if {$i < $param_count} {
                
            } else {
                break
            }
            set parameter_info [ lindex $parameters $i ]
            set parameter [ lindex $parameter_info 0 ]
            set line "   $parameter"
            if {$i == $param_count - 1} {
                
            } else {
                append line ";"
            }
            lappend result $line
            incr i
        }
        set line "\)"
    }
    if {$type == "function"} {
        append line " return $returns"
    }
    lappend result $line
    if {$abstract} {
        lappend result "is abstract"
    } else {
        if {$print_body} {
            set body [ handle_is result $body ]
            lappend result "begin"
            foreach line $body {
                lappend result "   $line"
            }
            lappend result "end $name"
        }
    }
    if {$print_body} {
        append_notempty \
        	result $body_footer
    } else {
        append_notempty \
        	result $spec_footer
    }
    set space [ make_indent $depth ]
    set nline [ llength $result ]
    set i 0
    while { 1 } {
        if {$i < $nline} {
            
        } else {
            break
        }
        puts -nonewline $fhandle $space
        if {$i == $nline - 1} {
            puts -nonewline $fhandle [ lindex $result $i ]
            puts $fhandle ";"
        } else {
            puts $fhandle [ lindex $result $i ]
        }
        incr i
    }
    puts $fhandle ""
}

proc print_type { fhandle component } {
    lassign $component diagram_id name signature body
    lassign $signature type prop_list parameters returns
    array set props $prop_list
    set depth 1
    set has_body 1
    print_type_kernel \
    $fhandle \
    $depth \
    $props(subtype) \
    $props(abstract) \
    $props(tagged) \
    $name \
    $body \
    $has_body
}

proc print_type_kernel { fhandle depth type abstract tagged name body has_body } {
    set result {}
    set line ""
    append line "$type "
    append line "$name "
    append line "is"
    if {$abstract} {
        append line " abstract"
    }
    if {$tagged} {
        append line " tagged"
    }
    lappend result $line
    if {$has_body} {
        foreach line $body {
            lappend result "   $line"
        }
    }
    set space [ make_indent $depth ]
    set nline [ llength $result ]
    set i 0
    while { 1 } {
        if {$i < $nline} {
            
        } else {
            break
        }
        puts -nonewline $fhandle $space
        if {$i == $nline - 1} {
            puts -nonewline $fhandle [ lindex $result $i ]
            puts $fhandle ";"
        } else {
            puts $fhandle [ lindex $result $i ]
        }
        incr i
    }
    puts $fhandle ""
}

proc put_credits { fhandle } {
    set version [ version_string ]
    puts $fhandle \
        "--  Autogenerated with DRAKON Editor $version"
}

proc shelf { primary secondary } {
    set lines {}
    set plines [ split $primary "\n" ]
    if {$secondary == "record"} {
        if {[ lindex $plines 0 ] == "null"} {
            set result "null record"
        } else {
            lappend lines "record"
            foreach line $plines {
                lappend lines "   $line;"
            }
            lappend lines "end record"
            set result [ join $lines "\n" ]
        }
    } else {
        if {$secondary == "is"} {
            lappend lines "#BEGIN_IS"
            foreach line $plines {
                lappend lines "   $line"
            }
            lappend lines "#END_IS"
            set result [ join $lines "\n" ]
        } else {
            if {$secondary == "with"} {
                lappend lines "#BEGIN_WITH"
                foreach line $plines {
                    lappend lines "   $line"
                }
                lappend lines "#END_WITH"
                set result [ join $lines "\n" ]
            } else {
                set result $primary
            }
        }
    }
    return $result
}

