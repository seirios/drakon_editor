proc multi_extract { body ifirst beginstr endstr do_unindent } {
    set lines {}
    set i $ifirst
    while { 1 } {
        set first [ lindex $body $i ]
        if {[ unindent $first ] == $beginstr} {
            
        } else {
            break
        }
        incr i
        lassign \
        [ collect_until $body $i $endstr $do_unindent ] \
        i extracted
        incr i
        lappend lines $extracted
    }
    return [ list $i $lines ]
}

