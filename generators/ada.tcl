proc generate_item { db item_id parent_loop } {
    set type [ nogoto::get_node_type $db $item_id ]
    if {$type == "action"} {
        return [ nogoto::gen_action \
        	$db $item_id $parent_loop ]
    } else {
        if {$type == "if"} {
            return [ nogoto::gen_if \
            	$db $item_id $parent_loop ]
        } else {
            if {$type == "loop"} {
                
            } else {
                error "Unexpected switch value: $type"
            }
            return [ gen_loop \
            	$db $item_id ]
        }
    }
}

proc generate_subprogram { gdb callbacks diagram_id } {
    set extract_signature [ gen::get_callback $callbacks signature ]
    set generate_body [ gen::get_callback $callbacks body ]
    set commentator [ gen::get_callback $callbacks comment ]
    set start_info [ gen::get_start_info $gdb $diagram_id ]
    lassign \
    $start_info \
    start_icon params_icon name params_text start_item
    set signature [ $extract_signature $params_text $name ]
    lassign \
    $signature \
    errorMessage real_sign
    if {$errorMessage != ""} {
        gen::report_error $diagram_id {} $errorMessage
    }
    set tree ""
    set body ""
    set has_iterators 0
    set body [ gen::try_nogoto $gdb $diagram_id $callbacks $name ]
    if {$body == ""} {
        set node_list [ gen::generate_nodes \
        	$gdb $diagram_id $commentator ]
        lassign \
        [ gen::sort_items $node_list $start_item ] \
        sorted incoming
        set body [ generate_body $gdb $diagram_id \
        	$start_item $node_list $sorted $incoming ]
        set has_iterators 1
    }
    set declares [ gen::p.get_declares $gdb $diagram_id \
    	$has_iterators ]
    set body [ concat $declares $body ]
    return [ list $diagram_id $name $real_sign $body ]
}

proc generate_subprograms_core { db gdb callbacks } {
    set result {}
    $gdb eval {
    	select diagram_id
    	from diagrams
    	order by name
    } {
    	if { [ mwc::is_drakon $diagram_id ] && \
    	[ gen::has_branches $gdb $diagram_id ] } {
    		lappend result [ generate_subprogram \
    			$gdb $callbacks $diagram_id ]
    	}
    }
    return $result
}

proc handle_is { list_result body } {
    upvar 1 $list_result result
    lappend result "is"
    set lcnt 0
    set firstline [ lindex $body 0 ]
    if {$firstline == "##@@BEGIN_IS@@##"} {
        set body [lrange $body 1 end]
        foreach line $body {
            if {$line == "##@@END_IS@@##"} {
                break
            }
            lappend result "   $line"
            incr lcnt
        }
        set body [lrange $body $lcnt+1 end]
    }
    return $body
}

proc highlight { tokens } {
    variable ada_keywords
    variable ada_types
    return [ highlight_generic $ada_keywords $ada_types $tokens ]
}

proc highlight_generic { keywords kw_types tokens } {
    set result {}
    set state "idle"
    foreach token $tokens {
        lassign \
        $token \
        type text
        if {$state == "idle"} {
            set state \
            [ idle_default $keywords $kw_types result $type $text ]
        } else {
            if {$state == "string"} {
                lappend result $colors::syntax_string
                if {$text == "\""} {
                    set state "idle"
                } else {
                    if {$text == "\\"} {
                        set state "escaping"
                    } else {
                        if {$text == "\n"} {
                            set state "idle"
                        }
                    }
                }
            } else {
                if {$state == "escaping"} {
                    lappend result $colors::syntax_string
                    if {$text == "\n"} {
                        set state "idle"
                    } else {
                        set state "string"
                    }
                } else {
                    if {$state == "comment start"} {
                        if {$text == "-"} {
                            set state "comment line"
                            lappend result $colors::syntax_comment \
                            	$colors::syntax_comment
                        } else {
                            lappend result $colors::syntax_operator
                            set state \
                            [ idle_default $keywords $kw_types result $type $text ]
                        }
                    } else {
                        if {$state == "comment line"} {
                            lappend result \
                            	$colors::syntax_comment
                            if {$text == "\n"} {
                                set state "idle"
                            }
                        } else {
                            if {$state == "char"} {
                                if {$text == "'"} {
                                    lappend result \
                                    	$colors::syntax_string
                                    set state "idle"
                                } else {
                                    if {$text == "\\"} {
                                        lappend result \
                                        	$colors::syntax_string
                                        set state "char escaping"
                                    } else {
                                        if {$text == "\n"} {
                                            lappend result \
                                            	$colors::syntax_string
                                            set state "idle"
                                        } else {
                                            if {$text == "("} {
                                                lappend result $colors::syntax_operator
                                                set state "idle"
                                            } else {
                                                lappend result \
                                                	$colors::syntax_string
                                            }
                                        }
                                    }
                                }
                            } else {
                                if {$state == "char escaping"} {
                                    
                                } else {
                                    error "Unexpected switch value: $state"
                                }
                                lappend result \
                                  $colors::syntax_string
                                if {$text == "\n"} {
                                    set state "idle"
                                } else {
                                    set state "char"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if {$state == "comment start"} {
        lappend result $colors::syntax_operator
    }
    return $result
}

proc idle_default { keywords kw_types result_name type text } {
    upvar 1 $result_name result
    if {$text == "\""} {
        lappend result $colors::syntax_string
        set state "string"
    } else {
        if {$text == "'"} {
            lappend result $colors::syntax_string
            set state "char"
        } else {
            if {$text == "-"} {
                set state "comment start"
            } else {
                lappend result [standard_color $keywords $kw_types $type $text]
                set state "idle"
            }
        }
    }
    return $state
}

proc if_break_to_exit_when { orig } {
    set result {}
    foreach elem $orig {
        set type [ lindex $elem 0 ]
        if {$type == "if"} {
            lassign \
            $elem \
            type cond_part else_part then_part
            if {$else_part == "seq" &&
	$then_part == {seq break}} {
                lappend result [ list "exit" $cond_part ]
            } else {
                lappend result $elem
            }
        } else {
            lappend result $elem
        }
    }
    return $result
}

proc init_description { filename } {
    set result {}
    set pkgname [ package_name $filename ]
    lappend result "=== spec_header ==="
    lappend result "package $pkgname is"
    lappend result ""
    lappend result "=== spec_footer ==="
    lappend result "end $pkgname;"
    lappend result "=== body_header ==="
    lappend result "package body $pkgname is"
    lappend result ""
    lappend result "=== body_footer ==="
    lappend result "end $pkgname;"
    return [ join $result "\n" ]
}

