proc extract_when { body } {
    lassign \
    [ multi_extract $body 0 \
    	"##@@BEGIN_WHEN@@##" "##@@END_WHEN@@##" 1 ] \
    i when_lines
    set lines [ join_lists $when_lines " and then" ]
    if {$i > 0} {
        set body [lrange $body $i end]
    }
    return [ list $body $lines ]
}

